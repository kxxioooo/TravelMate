APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=travelmate
MYSQL_PASSWORD=change_me
MYSQL_DATABASE=travelmate

JWT_SECRET=change_me
JWT_EXPIRE_MINUTES=1440

FRONTEND_ORIGIN=http://localhost:5173

# ---------- v0.2 第三方服务 ----------
# 高德开放平台 Web 服务 Key(天气 + POI)。真实 Key 只放 .env,前端绝不持有
AMAP_API_KEY=change_me

# v0.2 起用于生成"城市代表性 10 种美食";v0.3 起同时承担 Chat 与 Agent Tool Calling
DEEPSEEK_API_KEY=change_me
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---------- v0.3 Agent ----------
# 单次问答最多允许几轮 Tool Calling(防止模型无限调用工具)
AGENT_MAX_TOOL_ROUNDS=5
# 每次请求最多注入多少条历史消息(数据库仍保存全部消息,这里只控制 token 成本)
AGENT_CONTEXT_MESSAGE_LIMIT=30

# ---------- v0.3.1 i18n 翻译缓存(契约 §6.3 / §13.2)----------
# 是否启用 entity_translations 缓存(关掉后仍会翻译,只是不再读写缓存)
TRANSLATION_CACHE_ENABLED=true
# 单次 DeepSeek 结构化翻译请求最多带多少条字段(同一批内互不相关的实体一起翻,降低调用次数)
TRANSLATION_BATCH_SIZE=10
# 单次翻译请求超时(秒):超时按失败降级,不阻塞整页
TRANSLATION_TIMEOUT_SECONDS=20
# 翻译失败后的有限重试次数(0 = 不重试)
TRANSLATION_MAX_RETRIES=1

# ---------- 会话城市标签(任务书《城市标签》§3.1)----------
# 单个会话最多能绑定多少个城市(0 / 1 / 多个都合法,这里只是上限)
CONVERSATION_CITY_MAX_COUNT=20

# ---------- 记忆 / 跨会话检索 / 长期画像(任务书《长期画像》§8)----------
# 总开关:false 时不检索历史、不学习偏好,正常聊天不受影响
MEMORY_FEATURE_ENABLED=true
# 两个授权默认值必须为 false:用户主动开启后才生效(**不要**在生产环境默认设 true)
MEMORY_HISTORY_DEFAULT_ENABLED=false
MEMORY_PROFILE_LEARNING_DEFAULT_ENABLED=false
# 跨会话检索的候选窗口:默认最近 180 天 / 最多 500 条(显式"我以前说过什么"会临时放宽)
MEMORY_HISTORY_LOOKBACK_DAYS=180
MEMORY_HISTORY_CANDIDATE_LIMIT=500
# 每轮最多注入几条历史证据 / 同一历史会话最多取几条
MEMORY_HISTORY_TOP_K=5
MEMORY_HISTORY_PER_CONVERSATION_LIMIT=2
# 单条证据/画像摘要/动态上下文的最大字符数(控制 token 成本)
MEMORY_HISTORY_EXCERPT_MAX_CHARS=300
MEMORY_PROFILE_MAX_CHARS=600
MEMORY_CONTEXT_MAX_CHARS=2500
# 模型输入 token 预算(按实际模型调整);超出时先裁低相关证据
MEMORY_MODEL_INPUT_TOKEN_BUDGET=8000

# ---------- RAG 知识增强(任务书《RAG》§12.1)----------
# 默认全部关闭:索引与 API 准备好之后再逐级开启
RAG_ENABLED=false
RAG_LOCAL_ENABLED=true
RAG_WEB_ENABLED=false
RAG_MEMORY_ENABLED=true

# Embedding:默认真实 bge-m3(1024 维)。
# 离线/无权重时可显式改成 hash 跑通链路 —— 它没有语义能力,只用于测试,
# 且版本号会写进 collection 与 vector_id,不会和真实模型混用。
RAG_EMBEDDING_PROVIDER=bge-m3
# 可以是模型名(BAAI/bge-m3),也可以是**本地权重目录的绝对路径**(离线加载)
RAG_EMBEDDING_MODEL=BAAI/bge-m3
RAG_EMBEDDING_DIM=1024
RAG_EMBEDDING_BATCH_SIZE=8

RAG_VECTOR_BACKEND=milvus-lite
# 相对 backend/ 或绝对路径;该目录是派生缓存,可整库删除后重建
RAG_MILVUS_URI=./app/data/rag_state/travelmate_milvus.db
RAG_COLLECTION=travelmate_knowledge_bgem3_v1
# Milvus Lite + 小数据量用 FLAT 最稳(不写 faiss 索引文件,跨进程可加载);
# 大数据量或 Standalone 可改 AUTOINDEX
RAG_INDEX_TYPE=FLAT

RAG_CHUNK_SIZE=700
RAG_CHUNK_OVERLAP=120
RAG_DENSE_TOP_K=20
RAG_BM25_TOP_K=20
RAG_FINAL_TOP_K=6
RAG_MAX_EVIDENCE_CHARS=6000
RAG_RETRIEVAL_TIMEOUT_SECONDS=12
RAG_MAX_TOOL_SEARCHES_PER_TURN=1

# 联网检索:默认关闭。没有 Key 时明确返回"未启用",不会伪造查询结果
WEB_SEARCH_PROVIDER=none
TAVILY_API_KEY=
WEB_SEARCH_TIMEOUT_SECONDS=8
WEB_SEARCH_MAX_RESULTS=5
WEB_PAGE_MAX_BYTES=1048576
WEB_CACHE_TTL_SECONDS=3600

# ---------- v0.3.3 文档生成(Word / PowerPoint)----------
# 总开关:false 时不注册文档工具,聊天与 RAG 照常
DOCUMENT_EXPORT_ENABLED=true
# 私有存储根目录(相对 backend/ 或绝对路径);**不得**放在前端静态目录下
DOC_STORAGE_ROOT=./app/data/generated_documents
DOC_MAX_DAYS=30
DOC_MAX_CITIES=20
DOC_MAX_FILE_BYTES=10485760
DOC_TTL_HOURS=168
DOC_MAX_PER_TURN=2
DOC_MAX_PER_USER_PER_DAY=20
DOC_GENERATION_TIMEOUT_SECONDS=150
DOC_DRAFT_TIMEOUT_SECONDS=90
DOC_MAX_SLIDES=40
