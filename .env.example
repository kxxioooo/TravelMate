APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=travelmate
MYSQL_PASSWORD=change_me
MYSQL_DATABASE=travelmate

JWT_SECRET=change_me
JWT_EXPIRE_MINUTES=1440

FRONTEND_ORIGIN=http://localhost:5173

# ---------- v0.2 第三方服务 ----------
# 高德开放平台 Web 服务 Key(天气 + POI)。真实 Key 只放 .env,前端绝不持有
AMAP_API_KEY=change_me

# v0.2 起用于生成"城市代表性 10 种美食";v0.3 起同时承担 Chat 与 Agent Tool Calling
DEEPSEEK_API_KEY=change_me
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---------- v0.3 Agent ----------
# 单次问答最多允许几轮 Tool Calling(防止模型无限调用工具)
AGENT_MAX_TOOL_ROUNDS=5
# 每次请求最多注入多少条历史消息(数据库仍保存全部消息,这里只控制 token 成本)
AGENT_CONTEXT_MESSAGE_LIMIT=30

# ---------- v0.3.1 i18n 翻译缓存(契约 §6.3 / §13.2)----------
# 是否启用 entity_translations 缓存(关掉后仍会翻译,只是不再读写缓存)
TRANSLATION_CACHE_ENABLED=true
# 单次 DeepSeek 结构化翻译请求最多带多少条字段(同一批内互不相关的实体一起翻,降低调用次数)
TRANSLATION_BATCH_SIZE=10
# 单次翻译请求超时(秒):超时按失败降级,不阻塞整页
TRANSLATION_TIMEOUT_SECONDS=20
# 翻译失败后的有限重试次数(0 = 不重试)
TRANSLATION_MAX_RETRIES=1
